# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Campaign API (optional, off unless set)
# Lets a script create campaigns without a magic-link session, because there is
# no way for one to click an email. Only /api/automations honours it; billing,
# admin and the Instagram OAuth flow stay session-only. Minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Revoking it is deleting the variable.
OPENREPLY_API_TOKEN=
# Only needed when the database holds more than one workspace. With several
# workspaces and no pin, the token is refused rather than guessing which
# account to write a campaign into.
OPENREPLY_API_WORKSPACE_ID=
